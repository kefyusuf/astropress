{
  "name": "astropress",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Astro tabanlı, agent-native CMS: gerçek content collections + MCP agent köprüsü (guardrail + insan onayı + RBAC + i18n).",
  "license": "MIT",
  "author": "Yusuf KEF <kefyusuf@gmail.com>",
  "keywords": [
    "astro",
    "cms",
    "agent",
    "mcp",
    "model-context-protocol",
    "headless-cms",
    "static-site",
    "ai",
    "guardrails",
    "rbac",
    "i18n"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "mcp": "node mcp/server.mjs",
    "mcp:http": "node mcp/http-server.mjs",
    "admin": "node mcp/http.mjs",
    "smoke": "node mcp/smoke.mjs",
    "smoke:http": "node mcp/smoke-http.mjs",
    "test": "node --test test/auth.test.mjs test/ops.test.mjs test/store.test.mjs test/http.admin.test.mjs",
    "backend:ci": "npm --prefix backend ci && npm --prefix backend test",
    "ci": "npm run build && npm test && npm run smoke && npm run smoke:http && npm run backend:ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "astro": "^7.4.7",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  }
}