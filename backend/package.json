{
  "name": "@astropress/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AstroPress agent-native CMS backend: NestJS + clean architecture (ports/adapters). İlk slice: çoklu site registry + site-başı locale config.",
  "license": "MIT",
  "author": "Yusuf KEF <kefyusuf@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/src/main.js",
    "seed": "node dist/src/scripts/bridge.js seed",
    "export": "node dist/src/scripts/bridge.js export",
    "token:mint": "node dist/src/scripts/token-mint.js",
    "test": "npm run build:test && node run-tests.mjs",
    "build:test": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.8.0",
    "better-sqlite3": "^12.0.0",
    "bullmq": "^5.81.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.0"
  }
}
