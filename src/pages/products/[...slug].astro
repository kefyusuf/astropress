---
import { getCollection } from 'astro:content';
import EntryView from '../../components/EntryView.astro';
import { defaultLocale } from '../../lib/site.config';
import { langOf } from '../../lib/i18n';
export async function getStaticPaths() {
  const products = await getCollection('products', (entry) => entry.data.status === 'published' && langOf(entry) === defaultLocale);
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<EntryView collection="products" entry={entry} lang={defaultLocale} />