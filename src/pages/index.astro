---
import Base from '../layouts/Base.astro';
import { publishedIn } from '../lib/i18n';
const posts = (await publishedIn('blog', 'tr'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const products = await publishedIn('products', 'tr');
---
<Base title="Köz Kahve — üçüncü nesil kahve, doğru kavurma" lang="tr" altHref="/en/">
  <section class="hero">
    <span class="kicker">Küçük parti · doğrudan ticaret</span>
    <h1>Üçüncü nesil kahve, <em>doğru kavurma.</em></h1>
    <p>Çekirdekten fincana izlenebilir tedarik; her parti için ayrı kavurma profili. Astro ile statik, hızlı ve agent'larla yönetilen bir mağaza.</p>
  </section>

  <div class="sec-h" id="products"><h2>Öne çıkan çekirdekler</h2><span>{products.length} ürün · stoklar senkron</span></div>
  <div class="grid">
    {products.map((p) => (
      <div class="card">
        <h3><a href={`/products/${p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.excerpt}</p>
        <span class="price">₺{p.data.price}</span>
      </div>
    ))}
  </div>

  <div class="sec-h" id="blog"><h2>Blog'dan son yazılar</h2><span>agent + insan ortak üretimi</span></div>
  <div class="post-list">
    {posts.map((p) => (
      <a class="post-row" href={`/blog/${p.id}/`}>
        <span class="date">{p.data.date.toLocaleDateString('tr-TR', { day: '2-digit', month: 'short' })}</span>
        <span>
          <h3>{p.data.title}</h3>
          <p>{p.data.excerpt}</p>
        </span>
      </a>
    ))}
  </div>
</Base>