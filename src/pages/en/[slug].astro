---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { altHref } from '../../lib/i18n';
export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.status === 'published' && data.lang === 'en');
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const alt = await altHref('pages', entry);
---
<Base title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDesc || entry.data.excerpt} lang="en" altHref={alt}>
  <article class="prose">
    <div class="meta"><span class="badge">Page</span></div>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</Base>