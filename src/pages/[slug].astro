---
import { getCollection } from 'astro:content';
import EntryView from '../components/EntryView.astro';
import { defaultLocale } from '../lib/site.config';
import { langOf } from '../lib/i18n';
export async function getStaticPaths() {
  const pages = await getCollection('pages', (entry) => entry.data.status === 'published' && langOf(entry) === defaultLocale);
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<EntryView collection="pages" entry={entry} lang={defaultLocale} />