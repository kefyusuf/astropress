---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { altHref } from '../../lib/i18n';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.status === 'published' && data.lang !== 'en');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const alt = await altHref('blog', entry);
---
<Base title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDesc || entry.data.excerpt} lang="tr" altHref={alt}>
  <article class="prose">
    <div class="meta">
      <span class="badge">Yazı</span>
      <span>{entry.data.author}</span>
      <span>{entry.data.date.toLocaleDateString('tr-TR')}</span>
    </div>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</Base>