---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { altHref, type Col, type Lang } from '../lib/i18n';
import { ui } from '../lib/ui';
interface Props { collection: Col; entry: any; lang: Lang; }
const { collection, entry, lang } = Astro.props;
const { Content } = await render(entry);
const alt = await altHref(collection, entry);
const t = ui[lang];
const badge = collection === 'blog' ? t.badgePost : collection === 'products' ? t.badgeProduct : t.badgePage;
---
<Base title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDesc || entry.data.excerpt} lang={lang} altHref={alt}>
  <article class="prose">
    <div class="meta">
      <span class="badge">{badge}</span>
      {collection === 'blog' && (
        <>
          <span>{entry.data.author}</span>
          <span>{entry.data.date.toLocaleDateString(t.dateLocale)}</span>
        </>
      )}
      {collection === 'products' && (
        <>
          <span class="price">₺{entry.data.price}</span>
          <span>{t.stock} {entry.data.stock}</span>
        </>
      )}
    </div>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</Base>