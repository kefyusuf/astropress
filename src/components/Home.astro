---
import Base from '../layouts/Base.astro';
import { publishedIn, homeHrefs, formatPrice, type Lang } from '../lib/i18n';
import { localePrefix } from '../lib/site.config';
import { uiFor } from '../lib/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = uiFor(lang);
const prefix = localePrefix(lang);
const links = homeHrefs(lang);
const posts = (await publishedIn('blog', lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const products = await publishedIn('products', lang);
---
<Base title={t.homeTitle} lang={lang} links={links}>
  <section class="hero">
    <span class="kicker">{t.kicker}</span>
    <h1>{t.heroTitlePre}<em>{t.heroTitleAccent}</em></h1>
    <p>{t.heroBody}</p>
  </section>

  <div class="sec-h" id="products"><h2>{t.featured}</h2><span>{t.productsCount(products.length)}</span></div>
  <div class="grid">
    {products.map((p) => (
      <div class="card">
        <h3><a href={`${prefix}/products/${p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.excerpt}</p>
        <span class="price">{formatPrice(p.data.price, t.dateLocale)}</span>
      </div>
    ))}
  </div>

  <div class="sec-h" id="blog"><h2>{t.latest}</h2><span>{t.coproduction}</span></div>
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <article class="post-row">
          <time class="date" datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString(t.dateLocale, { day: '2-digit', month: 'short' })}</time>
          <div>
            <h3><a href={`${prefix}/blog/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.excerpt}</p>
          </div>
        </article>
      </li>
    ))}
  </ul>
</Base>
