---
import Base from '../layouts/Base.astro';
import { publishedIn, other, type Lang } from '../lib/i18n';
import { localePrefix } from '../lib/site.config';
import { ui } from '../lib/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const prefix = localePrefix(lang);
const posts = (await publishedIn('blog', lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const products = await publishedIn('products', lang);
const alt = `${localePrefix(other(lang))}/`;
---
<Base title={t.homeTitle} lang={lang} altHref={alt}>
  <section class="hero">
    <span class="kicker">{t.kicker}</span>
    <h1 set:html={t.heroTitle} />
    <p>{t.heroBody}</p>
  </section>

  <div class="sec-h" id="products"><h2>{t.featured}</h2><span>{t.productsCount(products.length)}</span></div>
  <div class="grid">
    {products.map((p) => (
      <div class="card">
        <h3><a href={`${prefix}/products/${p.id}/`}>{p.data.title}</a></h3>
        <p>{p.data.excerpt}</p>
        <span class="price">₺{p.data.price}</span>
      </div>
    ))}
  </div>

  <div class="sec-h" id="blog"><h2>{t.latest}</h2><span>{t.coproduction}</span></div>
  <div class="post-list">
    {posts.map((p) => (
      <a class="post-row" href={`${prefix}/blog/${p.id}/`}>
        <span class="date">{p.data.date.toLocaleDateString(t.dateLocale, { day: '2-digit', month: 'short' })}</span>
        <span>
          <h3>{p.data.title}</h3>
          <p>{p.data.excerpt}</p>
        </span>
      </a>
    ))}
  </div>
</Base>