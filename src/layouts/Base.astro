---
import '../styles/global.css';
import { defaultLocale, localePrefix, locales, type Locale } from '../lib/site.config';
import { other } from '../lib/i18n';
import { ui } from '../lib/ui';
interface Props { title: string; description?: string; lang?: Locale; altHref?: string; }
const { title, lang = defaultLocale, altHref } = Astro.props;
const t = ui[lang];
const description = Astro.props.description || t.description;
const home = localePrefix(lang) + '/';
const aboutHref = `${localePrefix(lang)}/${t.aboutSlug}/`;
const switchHref = altHref || `${localePrefix(other(lang))}/`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <header class="site-head">
    <a class="brand" href={home}>
      <span class="brand-mark">☕</span> Köz Kahve
    </a>
    <nav>
      <a href={home}>{t.shop}</a>
      <a href={home + '#blog'}>Blog</a>
      <a href={aboutHref}>{t.about}</a>
      <span class="lang-switch">
        {locales.map((l) => l === lang
          ? <span class="active">{l.toUpperCase()}</span>
          : <a href={switchHref}>{l.toUpperCase()}</a>)}
      </span>
    </nav>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-foot">
    <span>{t.footerManagedPre}<strong>AstroPress</strong>{t.footerManagedPost}</span>
    <span>{t.footerTagline}</span>
  </footer>
</body>
</html>